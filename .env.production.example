# ============================================================
# EnerVision — environnement PRODUCTION / distant
#
# Copier en .env (jamais commité) :
#   Copy-Item .env.production.example .env
#
# Utilisé automatiquement par : .\docker.ps1 prod up -d
# (équivalent : docker compose --env-file .env -f docker-compose.yaml
#  -f docker-compose-data.yaml up -d)
#
# Ce fichier ne contient QUE des placeholders vides : les vraies valeurs
# de production ne doivent jamais être commitées. Les secrets clients
# Keycloak (keycloak_client_secret, keycloak_frontend_client_secret,
# keycloak_db_password) passent par des Docker secrets, jamais par ce
# fichier.
# ============================================================

APP_ENVIRONMENT=production

# --- PostgreSQL ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PWD=
POSTGRES_APP_USER=
POSTGRES_APP_PWD=

# --- MLflow (docker-compose-data.yaml) ---
POSTGRES_USER_MLFLOW=
POSTGRES_PASSWORD_MLFLOW=

# --- backend/core ---
CORS_ALLOWED_ORIGINS=

# --- Keycloak : instance déjà déployée sur l'infrastructure distante.
# Ne JAMAIS pointer vers le Keycloak Docker local ici. ---
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=

# --- etl ---
ETL_INTERVAL_SECONDS=
ETL_LOOKBACK_MINUTES=
ETL_FORWARD_FILL_DEPTH=

# --- Frontend / workers ---
CORE_URL=
MOCK_API_URL=
POLL_INTERVAL_SECONDS=

# --- Azure : STORAGE_ACCOUNT/CONTAINER_NAME/SAS_INGESTION utilisés par
# worker-ingestion (archivage brut) ; SAS_ETL/SAS_MLFLOW par
# scripts/verify_azure_access.py, pas par la stack Docker. ---
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_SAS_INGESTION=
AZURE_SAS_ETL=
AZURE_SAS_MLFLOW=
