{
  "realm": "enervision",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Accès complet : gestion des sites, utilisateurs, configuration." },
      { "name": "user", "description": "Lecture des données de consommation et du dashboard." }
