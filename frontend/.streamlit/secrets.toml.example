# Copier ce fichier en .streamlit/secrets.toml (jamais commité — voir .gitignore)
# et remplacer les placeholders ci-dessous par les vraies valeurs.
#
# - redirect_uri : URL absolue de CE frontend + "/oauth2callback"
#   (adapter selon l'environnement : local, staging, production)
# - cookie_secret : chaîne aléatoire forte, générée par ex. avec :
#     python -c "import secrets; print(secrets.token_hex(32))"
# - client_id / client_secret : client Keycloak "frontend-streamlit"
#   (Credentials tab dans la console Keycloak — voir README pour la config exacte)
# - server_metadata_url : découverte OIDC du realm Keycloak
# - expose_tokens : nécessaire pour que le frontend puisse transmettre
#   l'access token à backend/core (Authorization: Bearer <token>)

[auth]
redirect_uri =
cookie_secret =
client_id =
client_secret =
server_metadata_url =
expose_tokens =
