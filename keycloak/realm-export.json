{
  "realm": "enervision",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "enervision-frontend",
      "name": "EnerVision Frontend (Streamlit) - dev local",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-dev-frontend-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://enervisiong3.prod/oauth2callback"
      ],
      "webOrigins": [
        "https://enervisiong3.prod"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://enervisiong3.prod/*"
      },
      "protocolMappers": [
        {
          "name": "audience-enervision-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "enervision-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "enervision-api",
      "name": "EnerVision Core API - dev local",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-dev-api-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "id": "7e57c0de-0000-4000-8000-000000000001",
      "username": "test",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "email": "test@enervision.local",
      "credentials": [
        {
          "type": "password",
          "value": "test",
          "temporary": false
        }
      ]
    }
  ]
}
